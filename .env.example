# Copy this file to .env and fill in real values, or export these directly
# in your shell. Never commit a real .env.

# --- Ollama (native /api/chat, structured JSON output) ---------------------
# Base URL only -- /api/chat is appended in code. This is a separate host
# from SSH_HOST below (Ollama host vs. the Kali execution target).
OLLAMA_HOST=http://10.209.1.214:11434
# Must match a model name registered on that host via:
#   ollama create pentest-agent -f deploy/Modelfile
# (see deploy/Modelfile for why BaronLLM is the recommended base model)
OLLAMA_MODEL=pentest-agent
# Optional: used for a prompt-size warning heuristic against your model's
# context window, not for the Modelfile itself (num_ctx normally lives
# there). Match it to what deploy/Modelfile actually sets.
OLLAMA_NUM_CTX=4096

# --- Remote tool execution ---------------------------------------------------
# "direct": run commands on the Kali box's own shell over SSH.
# "docker": run them inside a container on that box, via SSH + docker exec.
EXEC_MODE=direct
SSH_HOST=192.168.1.60
SSH_USER=pentester
SSH_KEY_PATH=/home/you/.ssh/id_ed25519_pentest
SSH_PORT=22
# Required only when EXEC_MODE=docker.
DOCKER_CONTAINER=

# Remote-command budget, in seconds. Full nmap/hydra/rockyou.txt runs
# legitimately take a long time -- this is separate from the connect timeout
# below, so a dead host still fails fast.
EXEC_TIMEOUT_SECONDS=7200
# How long to wait for the SSH connection/auth handshake itself.
SSH_CONNECT_TIMEOUT_SECONDS=15

# NOTE: the auto-sudo-retry path requires NOPASSWD sudo configured for
# SSH_USER on the remote host -- a non-interactive (BatchMode) SSH session
# has no terminal for an interactive sudo password prompt.

# "remote" (default): write_file/read_file tool calls operate on the same
# remote filesystem namespace the other tools use (hash files, wordlists,
# sqlmap output, etc. all need to be visible to the tools that consume them).
# "local": escape hatch to stage content on the orchestrator's own
# filesystem instead.
REMOTE_WRITE_MODE=remote

# Path to the httpx binary on the remote target. Default relies on $PATH.
# NOTE: on Kali this is packaged as "httpx-toolkit", NOT "httpx" -- "httpx"
# is the unrelated python3-httpx HTTP client CLI and is often already
# installed, silently shadowing the real tool if you override this to
# just "httpx".
HTTPX_BIN=httpx-toolkit

# --- Local paths (orchestrator machine) -------------------------------------
LOG_DIR=./logs
CACHE_DIR=./.cache
REPORT_DIR=./reports
